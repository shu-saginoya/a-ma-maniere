---
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../data/site';
---

<Layout
  title={`店舗情報・アクセス｜${siteConfig.name}`}
  description="A ma maniereの店舗情報・アクセス方法をご紹介します。"
>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-2xl font-bold">店舗情報・アクセス</h1>

    <dl class="mt-8 space-y-2">
      <div class="flex gap-4">
        <dt class="w-24 shrink-0 font-bold">店舗名</dt>
        <dd>
          {siteConfig.name}（{siteConfig.nameKana}）
        </dd>
      </div>
      <div class="flex gap-4">
        <dt class="w-24 shrink-0 font-bold">住所</dt>
        <dd>
          {siteConfig.postalCode} {siteConfig.address}
        </dd>
      </div>
      <div class="flex gap-4">
        <dt class="w-24 shrink-0 font-bold">電話番号</dt>
        <dd>
          <a href={siteConfig.telHref} class="underline">
            {siteConfig.tel}
          </a>
        </dd>
      </div>
      <div class="flex gap-4">
        <dt class="w-24 shrink-0 font-bold">営業時間</dt>
        <dd>{siteConfig.businessHours}</dd>
      </div>
      <div class="flex gap-4">
        <dt class="w-24 shrink-0 font-bold">定休日</dt>
        <dd>{siteConfig.closedDay}</dd>
      </div>
    </dl>

    <p class="mt-4 text-sm text-stone-600">
      お店の位置がわかりづらい場所にございますので、ご注意ください。
    </p>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <figure>
        <img
          src="/images/access_photo01.jpg"
          alt="つくば方面から見た店舗周辺（西田中バス停付近）"
          class="w-full rounded border border-stone-200"
        />
        <figcaption class="mt-1 text-xs text-stone-500">つくば方面から</figcaption>
      </figure>
      <figure>
        <img
          src="/images/access_photo02.jpg"
          alt="店舗外観と駐車スペース"
          class="w-full rounded border border-stone-200"
        />
        <figcaption class="mt-1 text-xs text-stone-500">店舗外観・駐車スペース</figcaption>
      </figure>
    </div>

    <h2 class="mt-8 text-xl font-bold">アクセス</h2>
    <div class="mt-4 aspect-video w-full overflow-hidden rounded border border-stone-200">
      <iframe
        src={siteConfig.googleMapEmbedSrc}
        title="Googleマップ：A ma maniereの店舗位置"
        width="100%"
        height="100%"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </main>
</Layout>
