---
import { siteConfig } from '../data/site';

const navItems = [
  { href: '/', label: 'トップ' },
  { href: '/about/', label: 'A ma maniereについて' },
  { href: '/price/', label: 'お直し・料金' },
  { href: '/access/', label: '店舗情報・アクセス' },
  { href: '/contact/', label: 'お問い合わせ' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-stone-200 bg-white">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="flex items-center gap-2 text-lg font-bold text-stone-800">
      <img
        src="/images/shop_logo.png"
        width="177"
        height="40"
        alt={`${siteConfig.name}（${siteConfig.nameKana}）`}
        class="h-10 w-auto"
      />
    </a>
    <nav aria-label="メインナビゲーション">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-stone-700 hover:underline"
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
